# ============================================================
# Drishti Urban Road Intelligence — .gitignore
# ============================================================

# ── macOS ───────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.env
.env.local
*.egg
*.egg-info/
dist/
build/

# ── AI Model Weights (large binary files — store separately) ─
*.pt
*.onnx
*.engine
*.tflite
*.bin
*.pth

# ── Jupyter Notebooks ───────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ── Training Artifacts ──────────────────────────────────────
runs/
datasets/
scratch/
ai_output/
temp_rad_images/

# ── Logs ────────────────────────────────────────────────────
*.log
*.log.*
logs/

# ── OS / Editor ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
*.sublime-project
*.sublime-workspace

# ── Node (future-proofing) ──────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Secrets ─────────────────────────────────────────────────
*.pem
*.key
*.crt
secrets.json
config.local.*
