# ============================================================
# दृष्टि (Drishti) — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── AI Model ──────────────────────────────────────────────
# Path to the YOLOv8 pothole detection model weights
# Download from: see docs/ai-pipeline.md
MODEL_PATH=models/drishti_potholedetect_v1.pt

# ── Streamlit Server ──────────────────────────────────────
STREAMLIT_PORT=8501
STREAMLIT_HOST=0.0.0.0

# ── Demo Mode ─────────────────────────────────────────────
# Set to true to use pre-rendered inference videos instead of live model
DEMO_MODE=true

# ── Future API Integration Points ─────────────────────────
# These are NOT used in the current MVP; documented here for
# the production integration architecture described in docs/deployment.md

# MAPS_API_KEY=your_google_maps_or_mapbox_key_here
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key_here
# PWD_WEBHOOK_URL=https://your-municipal-api.gov.in/webhook/dockets
# SMS_ALERT_API_KEY=your_twilio_or_msg91_key_here

